# All VITE_ values are public browser configuration embedded in the frontend bundle.
VITE_API_BASE_URL=http://localhost:5000

# JSON RTCIceServer array. TURN credentials here must be short-lived and scoped;
# never put a long-lived TURN shared secret in a VITE_ variable or this file.
VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# For TURN-only connectivity checks, use "relay". Normal operation should use "all".
VITE_ICE_TRANSPORT_POLICY=all

# Example only; replace with your provider's TURN URL and short-lived credentials.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.example.net:3478"},{"urls":"turn:turn.example.net:3478?transport=udp","username":"<short-lived-username>","credential":"<short-lived-credential>"}]
