{
  "name": "game-co-tuong-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24.14.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host localhost --port 4173 --strictPort",
    "test": "vitest run"
  },
  "dependencies": {
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
